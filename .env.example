# Copy this file to .env.local and fill in your cloud keys.
# Never share .env.local. It stays on your computer.

# Public website address used when we show short links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase PostgreSQL (Project Settings → Database → Connection string)
# Use the "URI" connection string. Prisma will use this in Phase 2.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Upstash Redis (Console → your database → REST API)
UPSTASH_REDIS_REST_URL="https://[YOUR-ENDPOINT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-TOKEN]"
